# ── LLM (v1.0 에이전트용 — v0.1 예약 서비스는 키 없이도 전부 동작합니다) ──

# Google AI Studio에서 무료 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# LiteLLM 모델 문자열 — 이 값만 바꾸면 프로바이더/모델이 교체됩니다
# 예: gemini/gemini-2.5-flash, anthropic/claude-3-haiku-20240307, openai/gpt-4.1-mini
MODEL=gemini/gemini-2.5-flash

# 폴백 체인 (3회전에서 사용) — 쉼표 구분, 앞에서부터 순서대로 시도합니다
FALLBACK_MODELS=anthropic/claude-3-haiku-20240307,openai/gpt-4.1-mini

# 폴백용 키 자리 — 해당 프로바이더로 폴백을 실제로 돌릴 때만 채웁니다
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── DB ──────────────────────────────────────────────────────────────

# compose가 컨테이너 안에는 db 호스트 주소를 직접 주입하므로,
# 이 값은 호스트에서 직접 실행(비도커)하거나 psql GUI로 붙을 때만 쓰입니다
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meeting
